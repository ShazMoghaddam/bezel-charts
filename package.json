{
  "name": "bezel-charts",
  "version": "1.10.1",
  "description": "Small, polished charts as zero-dependency web components. Sparklines, lines, areas, bars, bar and line combos, waterfalls, histograms, box plots, rings, donuts, gauges, progress bars, bullet charts and heatmaps, with one-click static SVG export for READMEs.",
  "type": "module",
  "main": "dist/bezel-charts.js",
  "module": "dist/bezel-charts.js",
  "exports": {
    ".": "./dist/bezel-charts.js",
    "./spark": "./dist/charts/spark.js",
    "./line": "./dist/charts/line.js",
    "./area": "./dist/charts/area.js",
    "./bars": "./dist/charts/bars.js",
    "./combo": "./dist/charts/combo.js",
    "./waterfall": "./dist/charts/waterfall.js",
    "./histogram": "./dist/charts/histogram.js",
    "./boxplot": "./dist/charts/boxplot.js",
    "./scatter": "./dist/charts/scatter.js",
    "./ring": "./dist/charts/ring.js",
    "./donut": "./dist/charts/donut.js",
    "./gauge": "./dist/charts/gauge.js",
    "./progress": "./dist/charts/progress.js",
    "./bullet": "./dist/charts/bullet.js",
    "./heatmap": "./dist/charts/heatmap.js",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "serve": "python3 -m http.server 4173",
    "check": "npm run build && npm test && npm run size",
    "size": "node scripts/size.mjs",
    "test:browser": "python3 test/browser/studio.py",
    "fixtures": "node scripts/py-fixtures.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "charts",
    "sparkline",
    "svg",
    "dashboard",
    "readme",
    "data-visualization",
    "histogram",
    "boxplot",
    "combo-chart",
    "dual-axis",
    "waterfall",
    "bullet-chart"
  ],
  "author": "Shaz Moghaddam (https://shazmoghaddam.github.io)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShazMoghaddam/bezel-charts.git"
  },
  "homepage": "https://shazmoghaddam.github.io/bezel-charts/site/",
  "bugs": "https://github.com/ShazMoghaddam/bezel-charts/issues",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "linkedom": "0.18.15"
  }
}
